	(text "Bus SPI : RFID RC522 + ecran tactile"
		(exclude_from_sim no)
		(at 27.94 101.6 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "2c285b7d-32d6-578d-9699-19a39fc259e7")
	)
	(text "Bus SPI partage (GPIO18 = SCK, GPIO19 = MOSI, GPIO20 = MISO)\nUn CS par module : TFT_CS = GPIO21, TOUCH_CS = GPIO4, RFID_CS = GPIO11\nRC522 : 3,3 V UNIQUEMENT. IRQ non utilise.\nEcran : VCC et LED en 3,3 V (si le module a un cavalier J1, le fermer).\nT_IRQ non utilise (lecture du tactile en polling)."
		(exclude_from_sim no)
		(at 31.75 107.95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "326317eb-2fd7-5ba2-bd09-5a0044e0ac6c")
	)
	(text "Capteurs I2C : BH1750 + BMP280"
		(exclude_from_sim no)
		(at 27.94 44.45 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "5029a309-50c7-55de-b51f-56b2f9f1fd0f")
	)
	(text "Commande du relais"
		(exclude_from_sim no)
		(at 149.86 33.02 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "65556816-4c20-5a9e-be51-e3a2ef1f7016")
	)
	(text "Alimentation"
		(exclude_from_sim no)
		(at 327.66 199.39 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7208aabd-65ea-5d48-b181-5e3d1a54f64b")
	)
	(text "Relais K1 commande par GPIO10 (RELAY_CMD) via le MOSFET Q1 (BS270).\nBobine 5 V entre +5V et le drain de Q1. D1 = diode de roue libre (cathode cote +5V).\nContacts du 1er inverseur sur le bornier J1 : 1 = NO (travail), 2 = COM, 3 = NC (repos).\nLe 2e inverseur (21/22/24) n'est pas utilise."
		(exclude_from_sim no)
		(at 156.718 86.868 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "93533940-2e87-5577-ad91-8161ecb65c16")
	)
	(text "Alimentation : la carte est alimentee par USB.\n+5V = broche 5V de la carte (MQ), +3V3 = broche 3V3 (tout le reste)."
		(exclude_from_sim no)
		(at 331.47 241.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b7e54f24-c8ef-5297-b66b-5641b8cbf82a")
	)
	(text "Microcontroleur ESP32-C6 (DevKit GEII fourni par l'IUT)"
		(exclude_from_sim no)
		(at 167.64 139.7 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "bf9c585c-af3f-5d6a-ade5-720e2933f990")
	)
	(text "Capteur MQ alimente en 5 V : sa sortie AO peut monter a 5 V.\nPont diviseur R1/R2 : 5 V x 2k / (1k + 2k) = 3,33 V max sur GPIO1.\nDO non utilise."
		(exclude_from_sim no)
		(at 309.372 85.852 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d2af906b-7b44-56d4-8d1b-91b9cb788d81")
	)
	(text "Bus I2C (GPIO6 = SDA, GPIO7 = SCL)\nBH1750 : ADDR -> GND = adresse 0x23\nBMP280 : CSB -> 3V3 (mode I2C), SDO -> GND = adresse 0x76\nLes modules GY-302 / GY-BMP280 ont deja leurs resistances de tirage I2C."
		(exclude_from_sim no)
		(at 31.75 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d561e415-6c7f-56d3-9fa7-c20d0f091f90")
	)
