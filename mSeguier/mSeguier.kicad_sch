		(uuid "d2af906b-7b44-56d4-8d1b-91b9cb788d81")
	)
	(text "Bus I2C (GPIO6 = SDA, GPIO7 = SCL)\nBH1750 : ADDR -> GND = adresse 0x23\nBMP280 : CSB -> 3V3 (mode I2C), SDO -> GND = adresse 0x76\nLes modules GY-302 / GY-BMP280 ont deja leurs resistances de tirage I2C."
		(exclude_from_sim no)
		(at 31.75 50.8 0)
		(effects
