	)
	(text "Bus SPI partage (GPIO18 = SCK, GPIO19 = MOSI, GPIO20 = MISO)\nUn CS par module : TFT_CS = GPIO21, TOUCH_CS = GPIO4, RFID_CS = GPIO11\nRC522 : 3,3 V UNIQUEMENT. IRQ non utilise.\nEcran : VCC et LED en 3,3 V (si le module a un cavalier J1, le fermer).\nT_IRQ non utilise (lecture du tactile en polling)."
		(exclude_from_sim no)
		(at 31.75 107.95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "326317eb-2fd7-5ba2-bd09-5a0044e0ac6c")
	)
